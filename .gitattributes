# Normalise text to LF in the repository and in working trees on every platform.
* text=auto eol=lf

# Windows command scripts must keep CRLF or cmd.exe misreads labels and multi-line blocks.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# POSIX scripts must stay LF even when checked out on Windows.
*.sh text eol=lf
gradlew text eol=lf
adapters/ruby/bin/* text eol=lf

*.png binary
*.woff2 binary
*.jar binary
*.zip binary
*.gz binary
*.ico binary
