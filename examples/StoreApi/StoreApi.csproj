<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The OpenAPI generator turns XML comments on handlers, contracts and properties into the API's descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Handlers document only their API parameters; injected services (db, principal, preview...) are not part of the API. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests read the seed constants (the named customer, product and SKU the examples rely on). -->
    <InternalsVisibleTo Include="StoreApi.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.AspNetCore/Sendproof.AspNetCore.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.EntityFrameworkCore/Sendproof.EntityFrameworkCore.csproj" />
    <!-- Optional data stores: price quotes and order rate limits in Redis, order histories and reviews in MongoDB, idempotency keys in DynamoDB. -->
    <ProjectReference Include="../../adapters/dotnet/Sendproof.Redis/Sendproof.Redis.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.MongoDB/Sendproof.MongoDB.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.DynamoDB/Sendproof.DynamoDB.csproj" />
    <!-- Journeys in code (Journeys/), and the generator that writes StoreOperations from the endpoint mappings. A package
         reference to Sendproof.Journeys brings the generator with it; a project reference names it as an analyzer. -->
    <ProjectReference Include="../../adapters/dotnet/Sendproof.Journeys/Sendproof.Journeys.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.Journeys.Generators/Sendproof.Journeys.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
