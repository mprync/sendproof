{
  "openapi": "3.0.3",
  "info": {
    "title": "Sendproof Conformance",
    "version": "1"
  },
  "paths": {
    "/items": {
      "post": {
        "operationId": "createItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "400": {
            "description": "Invalid"
          }
        }
      }
    },
    "/items/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getItem",
        "responses": {
          "200": {
            "description": "The item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "404": {
            "description": "Missing"
          }
        }
      },
      "patch": {
        "operationId": "renameItem",
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Renamed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteItem",
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/items/{id}/fail": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "failItem",
        "responses": {
          "409": {
            "description": "Handled failure"
          }
        }
      }
    },
    "/items/{id}/large": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "largeItem",
        "responses": {
          "200": {
            "description": "A body over the preview cap"
          }
        }
      }
    },
    "/items/{id}/redirect": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "redirectItem",
        "responses": {
          "302": {
            "description": "Redirect with a cookie"
          }
        }
      }
    },
    "/items/{id}/capture": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "captureItems",
        "responses": {
          "200": {
            "description": "Exceeds the capture caps"
          }
        }
      }
    },
    "/items/{id}/ordinary": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "ordinaryItem",
        "responses": {
          "201": {
            "description": "Not previewable"
          }
        }
      }
    },
    "/items/{id}/commit": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "commitItem",
        "responses": {
          "201": {
            "description": "Inserts then raw COMMITs"
          }
        }
      }
    },
    "/items/{id}/remember": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "rememberItem",
        "responses": {
          "201": {
            "description": "Inserts, then writes a guarded store"
          }
        }
      }
    },
    "/accounts": {
      "post": {
        "operationId": "createAccount",
        "responses": {
          "201": {
            "description": "Creates an account"
          }
        }
      }
    },
    "/accounts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getAccount",
        "responses": {
          "200": {
            "description": "The account"
          }
        }
      }
    },
    "/documents": {
      "post": {
        "operationId": "createDocument",
        "responses": {
          "201": {
            "description": "Inserts a MongoDB document"
          }
        }
      }
    },
    "/documents/archive": {
      "post": {
        "operationId": "archiveDocuments",
        "responses": {
          "204": {
            "description": "Runs aggregate with $out"
          }
        }
      }
    },
    "/documents/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getDocument",
        "responses": {
          "200": {
            "description": "The document"
          }
        }
      },
      "patch": {
        "operationId": "updateDocument",
        "responses": {
          "200": {
            "description": "Updates a document"
          }
        }
      },
      "delete": {
        "operationId": "deleteDocument",
        "responses": {
          "204": {
            "description": "Deletes a document"
          }
        }
      }
    },
    "/counters/{key}": {
      "parameters": [
        {
          "name": "key",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getCounter",
        "responses": {
          "200": {
            "description": "The counter"
          }
        }
      },
      "post": {
        "operationId": "incrementCounter",
        "responses": {
          "200": {
            "description": "Increments the counter"
          }
        }
      },
      "delete": {
        "operationId": "deleteCounter",
        "responses": {
          "204": {
            "description": "Deletes the counter"
          }
        }
      }
    },
    "/counters/{key}/take": {
      "parameters": [
        {
          "name": "key",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "takeCounter",
        "responses": {
          "200": {
            "description": "GETDEL of the counter"
          }
        }
      }
    },
    "/orders/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getOrder",
        "responses": {
          "200": {
            "description": "The order"
          }
        }
      },
      "delete": {
        "operationId": "deleteOrder",
        "responses": {
          "204": {
            "description": "Deletes the order"
          }
        }
      }
    },
    "/orders/{id}/touch": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "touchOrder",
        "responses": {
          "200": {
            "description": "UpdateItem on the order"
          }
        }
      }
    },
    "/orders/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "cancelOrder",
        "responses": {
          "200": {
            "description": "PartiQL UPDATE on the order"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateItem": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "RenameItem": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
