<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DotnetConformance</AssemblyName>
    <RootNamespace>DotnetConformance</RootNamespace>
    <!-- The shared runner starts the fixture on loopback; never read or write launch profiles. -->
    <UseLaunchSettings>false</UseLaunchSettings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.AspNetCore/Sendproof.AspNetCore.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.EntityFrameworkCore/Sendproof.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.MongoDB/Sendproof.MongoDB.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.Redis/Sendproof.Redis.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.DynamoDB/Sendproof.DynamoDB.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.Cassandra/Sendproof.Cassandra.csproj" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.OpenSearch/Sendproof.OpenSearch.csproj" />
  </ItemGroup>
</Project>
