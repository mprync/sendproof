<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DotnetConformance</AssemblyName>
    <RootNamespace>DotnetConformance</RootNamespace>
    <!-- The shared runner starts the fixture on loopback; never read or write launch profiles. -->
    <UseLaunchSettings>false</UseLaunchSettings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <ProjectReference Include="../../adapters/dotnet/TestBench.AspNetCore/TestBench.AspNetCore.csproj" />
    <ProjectReference Include="../../adapters/dotnet/TestBench.EntityFrameworkCore/TestBench.EntityFrameworkCore.csproj" />
  </ItemGroup>
</Project>
