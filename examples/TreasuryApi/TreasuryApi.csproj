<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The OpenAPI generator turns XML comments on handlers, contracts and properties into the API's descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Handlers document only their API parameters; injected services (db, principal, preview...) are not part of the API. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <ProjectReference Include="../../adapters/dotnet/TestBench.AspNetCore/TestBench.AspNetCore.csproj" />
    <ProjectReference Include="../../adapters/dotnet/TestBench.EntityFrameworkCore/TestBench.EntityFrameworkCore.csproj" />
  </ItemGroup>
</Project>
