{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sendproof confirmed preview v1",
  "type": "object",
  "required": ["status", "headers", "body", "changes", "effects", "logs", "rolledBack"],
  "properties": {
    "rolledBack": {"const": true},
    "status": {"type": "integer", "minimum": 100, "maximum": 599},
    "headers": {"type": "object", "additionalProperties": {"type": "string"}},
    "body": true,
    "changes": {"type": "array", "items": {"$ref": "#/$defs/changes"}},
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effects"}},
    "logs": {"type": "array", "items": {"$ref": "#/$defs/logs"}},
    "changesTruncated": {"type": "boolean"},
    "effectsTruncated": {"type": "boolean"},
    "logsTruncated": {"type": "boolean"},
    "session": {
      "type": "object",
      "description": "Present when the Preview ran inside a preview session: the session and this step's number, counting from 1. changes, effects and logs are this step's only.",
      "required": ["id", "step"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{32,}$"},
        "step": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "changes": {
      "type": "object",
      "required": ["operation", "table", "key", "before", "after"],
      "properties": {
        "operation": {"type": "string"},
        "table": {"type": "string", "description": "SQL table, MongoDB collection, DynamoDB table, or Redis key prefix."},
        "store": {"type": "string", "description": "Data store id from capabilities dataStores; absent for the SQL database. See data-stores.md."},
        "namespace": {"type": "string", "description": "Database that holds the collection or table."},
        "via": {"enum": ["upsert", "replace"], "description": "How a store change was made, when it was an upsert or a whole-document replacement. See data-stores.md."},
        "key": true,
        "before": {"type": ["null", "object"]},
        "after": {"type": ["null", "object"]}
      }
    },
    "effects": {
      "type": "object",
      "required": ["kind", "description"],
      "properties": {
        "kind": {"type": "string"},
        "description": {"type": "string"},
        "data": true,
        "delivered": {"type": "boolean"}
      }
    },
    "logs": {
      "type": "object",
      "required": ["level", "message"],
      "properties": {
        "level": {"type": "string"},
        "message": {"type": "string"},
        "category": {"type": "string"},
        "eventId": {
          "type": "object",
          "required": ["id"],
          "properties": {"id": {"type": "integer"}, "name": {"type": "string"}}
        },
        "offsetMs": {"type": "number", "minimum": 0},
        "elapsedMs": {"type": "number", "minimum": 0},
        "properties": {"type": "object", "additionalProperties": {"type": "string"}},
        "exception": {
          "type": "object",
          "required": ["type", "message"],
          "properties": {"type": {"type": "string"}, "message": {"type": "string"}}
        },
        "sql": {
          "type": "object",
          "required": ["text", "parameters"],
          "properties": {
            "text": {"type": "string"},
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "value", "dbType"],
                "properties": {
                  "name": {"type": "string"},
                  "value": {"type": ["string", "null"]},
                  "dbType": {"type": "string"}
                }
              }
            },
            "rowsAffected": {"type": "integer", "minimum": 0}
          }
        },
        "db": {
          "type": "object",
          "description": "A command to a non-SQL store, logged with level Db. See data-stores.md.",
          "required": ["system", "operation"],
          "properties": {
            "system": {"type": "string"},
            "operation": {"type": "string"},
            "target": {"type": "string"},
            "namespace": {"type": "string"},
            "statement": {"type": "string"},
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "value"],
                "properties": {"name": {"type": "string"}, "value": {"type": ["string", "null"]}}
              }
            },
            "rowsAffected": {"type": "integer", "minimum": 0},
            "blocked": {"type": "boolean"},
            "error": {"type": "string"}
          }
        }
      }
    }
  }
}
