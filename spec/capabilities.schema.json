{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Bench capabilities v1",
  "type": "object",
  "required": ["protocolVersion", "apiName", "environment", "openApiUrl", "database", "identity", "authProviders", "previewOperations"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "apiName": { "type": "string" },
    "environment": { "type": "string" },
    "openApiUrl": { "$ref": "#/$defs/localUrl" },
    "fieldModules": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/localUrl" } },
    "database": { "type": ["string", "null"] },
    "identity": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "required": ["name"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "role": { "type": "string", "description": "Display label from the authenticated identity's role claim type." }
          }
        }
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "url"],
        "properties": { "name": { "type": "string" }, "url": { "$ref": "#/$defs/localUrl" } }
      }
    },
    "authProviders": {
      "type": "array",
      "items": {
        "type": "object", "required": ["label", "kind", "url"],
        "properties": {
          "label": { "type": "string" },
          "kind": { "type": "string" },
          "url": { "oneOf": [{ "$ref": "#/$defs/localUrl" }, { "type": "null" }] }
        }
      }
    },
    "observedSend": { "type": "boolean", "description": "Supports Prefer: trace for advertised preview operations." },
    "dataStores": {
      "type": "array",
      "description": "Data stores the binding has hooked and how Preview treats each. See data-stores.md.",
      "items": {
        "type": "object", "required": ["system", "mode"],
        "properties": {
          "system": { "type": "string" },
          "name": { "type": "string" },
          "mode": { "enum": ["preview", "guard"] },
          "reason": { "type": "string" }
        }
      }
    },
    "previewUnavailable": {
      "type": "array",
      "description": "Operations an API author marked preview: false, with the reason the UI shows.",
      "items": {
        "type": "object", "required": ["method", "path", "reason"],
        "properties": {
          "method": { "type": "string", "pattern": "^[A-Z]+$" },
          "path": { "$ref": "#/$defs/localUrl" },
          "reason": { "type": "string" },
          "stores": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "previewOperations": {
      "type": "array",
      "items": {
        "type": "object", "required": ["method", "path"],
        "properties": { "method": { "type": "string", "pattern": "^[A-Z]+$" }, "path": { "$ref": "#/$defs/localUrl" } }
      }
    }
  },
  "$defs": {
    "localUrl": { "type": "string", "pattern": "^/(?!/)" }
  }
}
