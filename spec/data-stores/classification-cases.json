{
  "$comment": "Shared classification vectors. Every binding's unit tests run each case through its classifier and expect the result. Redis cases give the command and its arguments; MongoDB cases give the command document; DynamoDB cases give the action and its input. 'refusedInTransaction' names what a preview-mode MongoDB Preview must block before sending. Batch two: Cassandra cases give a CQL statement, or a native-protocol message with the statement it carries or the text it was prepared from; Elasticsearch cases (which cover OpenSearch) give the method, path and optional body (an object, an NDJSON array of objects, or raw text); Cosmos DB cases give an SDK operation type (with triggers: true when the request names a trigger) or the HTTP request; Firestore cases give the gRPC method path and optional request message, or a REST request. Batch-two cases also give the expected db.operation.name as 'operation'; their expect may be 'session' for allowed connection-level calls.",
  "version": 1,
  "redis": [
    { "command": ["GET", "k"], "expect": "read" },
    { "command": ["MGET", "a", "b"], "expect": "read" },
    { "command": ["SET", "k", "v"], "expect": "write" },
    { "command": ["INCR", "k"], "expect": "write" },
    { "command": ["GETEX", "k"], "expect": "write" },
    { "command": ["GETEX", "k", "PERSIST"], "expect": "write" },
    { "command": ["GETDEL", "k"], "expect": "write" },
    { "command": ["EVAL", "return 1", "0"], "expect": "write" },
    { "command": ["EVALSHA", "abc", "0"], "expect": "write" },
    { "command": ["EVAL_RO", "return 1", "0"], "expect": "read" },
    { "command": ["EVALSHA_RO", "abc", "0"], "expect": "read" },
    { "command": ["FCALL", "f", "0"], "expect": "write" },
    { "command": ["FCALL_RO", "f", "0"], "expect": "read" },
    { "command": ["SORT", "k"], "expect": "write" },
    { "command": ["SORT_RO", "k"], "expect": "read" },
    { "command": ["GEORADIUS_RO", "k", "0", "0", "1", "km"], "expect": "read" },
    { "command": ["XREAD", "STREAMS", "s", "0"], "expect": "read" },
    { "command": ["XREADGROUP", "GROUP", "g", "c", "STREAMS", "s", ">"], "expect": "write" },
    { "command": ["PUBLISH", "channel", "m"], "expect": "write" },
    { "command": ["SCRIPT", "LOAD", "return 1"], "expect": "write" },
    { "command": ["OBJECT", "ENCODING", "k"], "expect": "read" },
    { "command": ["CLIENT", "KILL", "ID", "1"], "expect": "write" },
    { "command": ["AUTH", "secret"], "expect": "session" },
    { "command": ["HELLO", "3", "AUTH", "user", "secret"], "expect": "session" },
    { "command": ["SELECT", "1"], "expect": "session" },
    { "command": ["MULTI"], "expect": "transaction" },
    { "command": ["EXEC"], "expect": "transaction" },
    { "command": ["JSON.GET", "k"], "expect": "read" },
    { "command": ["JSON.SET", "k", "$", "1"], "expect": "write" },
    { "command": ["get", "k"], "expect": "read" },
    { "command": ["SOMEFUTURECOMMAND", "k"], "expect": "write" }
  ],
  "mongodb": [
    { "command": { "find": "c", "filter": {} }, "expect": "read" },
    { "command": { "aggregate": "c", "pipeline": [{ "$match": {} }], "cursor": {} }, "expect": "read" },
    { "command": { "aggregate": "c", "pipeline": [{ "$match": {} }, { "$out": "o" }], "cursor": {} }, "expect": "write", "refusedInTransaction": "$out" },
    { "command": { "aggregate": "c", "pipeline": [{ "$merge": { "into": "o" } }], "cursor": {} }, "expect": "write", "refusedInTransaction": "$merge" },
    { "command": { "aggregate": "c", "pipeline": [{ "$facet": { "a": [{ "$match": {} }] } }], "cursor": {} }, "expect": "read" },
    { "command": { "insert": "c", "documents": [{ "_id": 1 }] }, "expect": "write" },
    { "command": { "update": "c", "updates": [{ "q": {}, "u": { "$set": { "a": 1 } } }] }, "expect": "write" },
    { "command": { "delete": "c", "deletes": [{ "q": {}, "limit": 1 }] }, "expect": "write" },
    { "command": { "findAndModify": "c", "query": {}, "update": { "$set": { "a": 1 } } }, "expect": "write" },
    { "command": { "findandmodify": "c", "query": {}, "remove": true }, "expect": "write" },
    { "command": { "count": "c" }, "expect": "read", "refusedInTransaction": "count" },
    { "command": { "listCollections": 1 }, "expect": "read", "refusedInTransaction": "listCollections" },
    { "command": { "drop": "c" }, "expect": "write", "refusedInTransaction": "drop" },
    { "command": { "create": "c" }, "expect": "write", "refusedInTransaction": "create" },
    { "command": { "createIndexes": "c", "indexes": [] }, "expect": "write" },
