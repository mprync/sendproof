{
  "name": "@sendproof/core",
  "version": "0.1.0-alpha.1",
  "description": "Sendproof workbench protocol and shared UI for Node",
  "license": "MIT",
  "keywords": [
    "openapi",
    "api-testing",
    "workbench",
    "swagger",
    "rollback"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node-http": {
      "types": "./dist/node-http.d.ts",
      "default": "./dist/node-http.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc -b && npm run pack-ui",
    "pack-ui": "node ../../../tools/pack-ui.mjs --out assets",
    "prepack": "npm run build"
  }
}
