{
  "name": "testbench/laravel-fixture",
  "description": "Conformance fixture: a disposable Laravel app for the Test Bench protocol runner.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-pdo_sqlite": "*",
    "laravel/framework": "^11.0|^12.0|^13.0",
    "testbench/core": "*@dev",
    "testbench/laravel": "*@dev"
  },
  "autoload": { "psr-4": { "Fixture\\": "app/" } },
  "repositories": [
    { "type": "path", "url": "../../core", "options": { "symlink": true } },
    { "type": "path", "url": "../../laravel", "options": { "symlink": true } }
  ],
  "config": { "sort-packages": true, "optimize-autoloader": false },
  "minimum-stability": "dev",
  "prefer-stable": true
}
