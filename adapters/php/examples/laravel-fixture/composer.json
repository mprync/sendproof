{
  "name": "sendproof/laravel-fixture",
  "description": "Conformance fixture: a disposable Laravel app for the Sendproof protocol runner.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-mongodb": "*",
    "ext-pdo_sqlite": "*",
    "aws/aws-sdk-php": "^3.300",
    "laravel/framework": "^11.0|^12.0|^13.0",
    "mongodb/laravel-mongodb": "^5.0",
    "opensearch-project/opensearch-php": "^2.4",
    "predis/predis": "^2.2 || ^3.0",
    "sendproof/core": "*@dev",
    "sendproof/laravel": "*@dev"
  },
  "autoload": { "psr-4": { "Fixture\\": "app/" } },
  "repositories": [
    { "type": "path", "url": "../../core", "options": { "symlink": true, "versions": { "sendproof/core": "dev-main" } } },
    { "type": "path", "url": "../../laravel", "options": { "symlink": true } }
  ],
  "config": { "sort-packages": true, "optimize-autoloader": false, "allow-plugins": { "php-http/discovery": true } },
  "minimum-stability": "dev",
  "prefer-stable": true
}
