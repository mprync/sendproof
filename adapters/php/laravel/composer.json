{
  "name": "sendproof/laravel",
  "description": "Sendproof for Laravel: an in-app API workbench with rollback previews and observed sends for Eloquent.",
  "type": "library",
  "license": "MIT",
  "authors": [{ "name": "Sendproof contributors" }],
  "keywords": ["laravel", "sendproof", "openapi", "api", "preview", "eloquent"],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/events": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "sendproof/core": "^0.1 || dev-main"
  },
  "require-dev": {
    "aws/aws-sdk-php": "^3.300",
    "elasticsearch/elasticsearch": "^8.0 || ^9.0",
    "google/cloud-firestore": "^2.0",
    "mongodb/laravel-mongodb": "^5.12",
    "opensearch-project/opensearch-php": "^2.4",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^11.0",
    "predis/predis": "^2.2 || ^3.0"
  },
  "suggest": {
    "mongodb/laravel-mongodb": "Preview MongoDB on a replica set and guard it on a standalone server (needs ext-mongodb)",
    "predis/predis": "Guard Redis writes during a Preview",
    "aws/aws-sdk-php": "Guard DynamoDB writes during a Preview",
    "elasticsearch/elasticsearch": "Guard Elasticsearch writes during a Preview",
    "opensearch-project/opensearch-php": "Guard OpenSearch writes during a Preview",
    "google/cloud-firestore": "Guard Firestore writes during a Preview (needs ext-grpc)"
  },
  "autoload": {
    "psr-4": { "Sendproof\\Laravel\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Sendproof\\Laravel\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["Sendproof\\Laravel\\SendproofServiceProvider"],
      "aliases": { "Sendproof": "Sendproof\\Laravel\\Facades\\Sendproof" }
    }
  },
  "repositories": [
    { "type": "path", "url": "../core", "options": { "symlink": true, "versions": { "sendproof/core": "dev-main" } } }
  ],
  "scripts": {
    "test": "phpunit"
  },
  "archive": {
    "exclude": ["/vendor", "/tests", "/phpunit.xml", "/.phpunit.result.cache", "/.phpunit.cache", "/composer.lock"]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": { "php-http/discovery": true },
    "platform": { "ext-grpc": "1.60.0" }
  },
  "minimum-stability": "stable"
}
