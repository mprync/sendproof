{
  "name": "testbench/laravel",
  "description": "Test Bench for Laravel: an in-app API workbench with rollback previews and observed sends for Eloquent.",
  "type": "library",
  "license": "MIT",
  "authors": [{ "name": "Test Bench contributors" }],
  "keywords": ["laravel", "testbench", "openapi", "api", "preview", "eloquent"],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/events": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "testbench/core": "^0.1 || dev-main"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "TestBench\\Laravel\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "TestBench\\Laravel\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["TestBench\\Laravel\\TestBenchServiceProvider"],
      "aliases": { "TestBench": "TestBench\\Laravel\\Facades\\TestBench" }
    }
  },
  "repositories": [
    { "type": "path", "url": "../core", "options": { "symlink": true } }
  ],
  "scripts": {
    "test": "phpunit"
  },
  "archive": {
    "exclude": ["/vendor", "/tests", "/phpunit.xml", "/.phpunit.result.cache", "/.phpunit.cache", "/composer.lock"]
  },
  "config": { "sort-packages": true },
  "minimum-stability": "stable"
}
