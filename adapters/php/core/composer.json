{
  "name": "sendproof/core",
  "description": "Framework-neutral Sendproof protocol core for PHP: preview, observed send, capture and embedded workbench assets.",
  "type": "library",
  "license": "MIT",
  "authors": [{ "name": "Sendproof contributors" }],
  "keywords": ["sendproof", "openapi", "api", "preview", "rollback"],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "aws/aws-sdk-php": "^3.300",
    "mongodb/mongodb": "^2.1",
    "phpunit/phpunit": "^11.0",
    "predis/predis": "^2.2 || ^3.0"
  },
  "suggest": {
    "mongodb/mongodb": "Guarded MongoDB client and Preview transactions (needs ext-mongodb)",
    "predis/predis": "Write guard for Predis Redis clients",
    "aws/aws-sdk-php": "Write guard for DynamoDB clients"
  },
  "autoload": {
    "psr-4": { "Sendproof\\Core\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Sendproof\\Core\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "embed-ui": "node ../../../tools/pack-ui.mjs --out resources/ui",
    "embed-store-tables": "node scripts/embed-store-tables.mjs"
  },
  "archive": {
    "exclude": ["/vendor", "/tests", "/phpunit.xml", "/.phpunit.result.cache", "/.phpunit.cache", "/composer.lock"]
  },
  "config": { "sort-packages": true },
  "minimum-stability": "stable"
}
