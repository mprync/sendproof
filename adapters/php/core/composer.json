{
  "name": "sendproof/core",
  "description": "Framework-neutral Sendproof protocol core for PHP: preview, observed send, capture and embedded workbench assets.",
  "type": "library",
  "license": "MIT",
  "authors": [{ "name": "Sendproof contributors" }],
  "keywords": ["sendproof", "openapi", "api", "preview", "rollback"],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "Sendproof\\Core\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Sendproof\\Core\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "embed-ui": "node ../../../tools/pack-ui.mjs --out resources/ui"
  },
  "archive": {
    "exclude": ["/vendor", "/tests", "/phpunit.xml", "/.phpunit.result.cache", "/.phpunit.cache", "/composer.lock"]
  },
  "config": { "sort-packages": true },
  "minimum-stability": "stable"
}
