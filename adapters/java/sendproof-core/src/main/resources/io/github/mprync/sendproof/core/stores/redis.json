  "notes": {
    "EVAL, EVALSHA, FCALL": "Writes: a script can write. EVAL_RO, EVALSHA_RO and FCALL_RO are reads because the server refuses writes inside them.",
    "GETEX, GETDEL": "Writes: GETEX can change a TTL and GETDEL deletes the key.",
    "SORT, GEORADIUS, GEORADIUSBYMEMBER": "Writes: each accepts STORE. Their _RO variants are reads.",
    "XREADGROUP": "Write: it moves entries into a consumer group pending list. XREAD is a read.",
    "PUBLISH, SPUBLISH, SUBSCRIBE": "Writes: delivery to subscribers cannot be undone.",
    "SCRIPT LOAD, FUNCTION LOAD": "Writes: they change server state.",
    "MULTI": "MULTI, EXEC and DISCARD are allowed, but each queued command is classified on its own. A queued write blocks the Preview before EXEC is sent; the binding then sends DISCARD or closes the connection, so nothing queued runs."
  }
