{
  "arazzo": "1.1.0",
  "info": { "title": "Conformance journeys", "version": "1.0.0" },
  "sourceDescriptions": [
    { "name": "fixture", "url": "/openapi.json", "type": "openapi" }
  ],
  "workflows": [
    {
      "workflowId": "itemLookup",
      "summary": "Look up an item",
      "inputs": {
        "type": "object",
        "properties": { "id": { "type": "string", "default": "conformance-item" } }
      },
      "steps": [
        {
          "stepId": "getItem",
          "operationPath": "{$sourceDescriptions.fixture.url}#/paths/~1items~1{id}/get",
          "parameters": [{ "name": "id", "in": "path", "value": "$inputs.id" }],
          "successCriteria": [{ "condition": "$statusCode == 200" }]
        }
      ]
    }
  ]
}
