// Local development workspace. The modules require each other at released
// semantic versions (see each go.mod); no go.mod carries a replace directive.
//
// The replace block below maps exactly those required versions to the checked-out
// directories, so the workspace builds before anything is tagged. Without it Go
// asks the module proxy for the unpublished versions as soon as two modules pull
// different third-party versions. Consumers and release tooling ignore this file:
// it is never part of a module zip. Bump the version here and in the go.mod
// requirements together (scripts/package.sh checks they agree).
go 1.26.0

use (
	.
	./chi
	./dynamobench
	./echo
	./examples
	./gin
	./gorm
	./mongobench
	./redisbench
	./searchbench
	./tools/modzip
)

replace (
	github.com/mprync/sendproof/adapters/go v0.1.0-alpha.1 => ./
	github.com/mprync/sendproof/adapters/go/chi v0.1.0-alpha.1 => ./chi
	github.com/mprync/sendproof/adapters/go/dynamobench v0.1.0-alpha.1 => ./dynamobench
	github.com/mprync/sendproof/adapters/go/echo v0.1.0-alpha.1 => ./echo
	github.com/mprync/sendproof/adapters/go/gin v0.1.0-alpha.1 => ./gin
	github.com/mprync/sendproof/adapters/go/gorm v0.1.0-alpha.1 => ./gorm
	github.com/mprync/sendproof/adapters/go/mongobench v0.1.0-alpha.1 => ./mongobench
	github.com/mprync/sendproof/adapters/go/redisbench v0.1.0-alpha.1 => ./redisbench
	github.com/mprync/sendproof/adapters/go/searchbench v0.1.0-alpha.1 => ./searchbench
)
