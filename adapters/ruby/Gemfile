# frozen_string_literal: true

source "https://rubygems.org"

# The three Sendproof gems are developed together and resolved from this checkout.
gem "sendproof-core", path: "sendproof"
gem "sendproof-activerecord", path: "sendproof-activerecord"
gem "sendproof-rails", path: "sendproof-rails"

# Tested against Rails 8.0 (Ruby 3.4).
gem "rails", "~> 8.0.0"
gem "sqlite3", ">= 2.1"
gem "puma", ">= 6.4"

# Data-store clients the Sendproof store hooks guard (see adapters/ruby/data-stores.md). Hosts add the ones they use.
gem "mongoid", "~> 9.0"
gem "mongo", "~> 2.21"
gem "redis-client", ">= 0.22"
gem "redis", "~> 5.0"
gem "aws-sdk-dynamodb", "~> 1.100"
# Batch two (guard only): the Elasticsearch and OpenSearch clients take the Faraday middleware, and
# Firestore's generated gRPC client takes the interceptor. Cassandra and Cosmos DB have no Ruby client.
gem "elasticsearch", "~> 8.0"
gem "opensearch-ruby", "~> 3.0"
gem "google-cloud-firestore", "~> 2.0"

# MySQL: Trilogy needs no client library, so the MySQL conformance entry runs on a plain machine.
gem "trilogy", "~> 2.9"

group :development, :test do
  # PostgreSQL for the ActiveRecord suite and the conformance fixture. Precompiled for common platforms;
  # elsewhere it builds against libpq (point bundler at it with `bundle config build.pg --with-pg-config=...`).
  gem "pg", "~> 1.5"
  gem "rake", "~> 13.2"
  gem "minitest", "~> 5.25"
  gem "rack-test", "~> 2.1"
end
