#!/usr/bin/env bash
# Runs the ActiveRecord suite against MySQL. The conformance runner provides BENCH_DATABASE=mysql and
# BENCH_DATABASE_URL, a fresh server database it drops afterwards. Needs the compose mysql service.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_env"
cd "$ROOT"
exec bundle exec rake test:sendproof-activerecord
