<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Sendproof for MongoDB</Title>
    <PackageTags>openapi;aspnetcore;api-testing;mongodb;transactions</PackageTags>
    <PackageIcon>package-icon.png</PackageIcon>
    <Description>Transactional previews and a write guard for the MongoDB .NET driver in Sendproof: a Preview runs in a transaction that is aborted afterwards, with document changes captured.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/package-icon.png" Pack="true" PackagePath="/" />
    <PackageReference Include="MongoDB.Driver" Version="3.14.1" />
    <ProjectReference Include="../Sendproof.AspNetCore/Sendproof.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sendproof.DataStores.Tests" />
  </ItemGroup>
</Project>
