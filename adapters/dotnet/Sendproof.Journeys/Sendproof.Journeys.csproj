<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Sendproof journeys</Title>
    <PackageTags>openapi;aspnetcore;api-testing;arazzo;journeys</PackageTags>
    <PackageIcon>package-icon.png</PackageIcon>
    <Description>Typed journeys for Sendproof: C# classes that describe an ordered set of API calls and what each one should write, turned into an Arazzo 1.1 document and its expectations at startup.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/package-icon.png" Pack="true" PackagePath="/" />
    <!-- The operations generator ships in this package as an analyzer, and its MSBuild property reaches it through build/. -->
    <None Include="../Sendproof.Journeys.Generators/bin/$(Configuration)/netstandard2.0/Sendproof.Journeys.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build/Sendproof.Journeys.props" Pack="true" PackagePath="build;buildTransitive" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The Arazzo object model, writer, reader and validator. -->
    <PackageReference Include="Bielu.Arazzo.NET" Version="3.2.0" />
    <PackageReference Include="Bielu.Arazzo.NET.Readers" Version="3.2.0" />
    <!-- Table and column names come from the EF Core model, document field names from the MongoDB class maps. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="MongoDB.Bson" Version="3.14.1" />
    <!-- The XML comments of an inputs class become the descriptions in its Arazzo inputs schema. -->
    <PackageReference Include="Namotion.Reflection" Version="3.5.1" />
    <ProjectReference Include="../Sendproof.AspNetCore/Sendproof.AspNetCore.csproj" />
    <ProjectReference Include="../Sendproof.Journeys.Generators/Sendproof.Journeys.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sendproof.Journeys.Testing" />
    <InternalsVisibleTo Include="Sendproof.Journeys.Tests" />
  </ItemGroup>
</Project>
