<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Sendproof for ASP.NET Core</Title>
    <PackageIcon>package-icon.png</PackageIcon>
    <Description>OpenAPI workbench and transactional request previews for ASP.NET Core.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/package-icon.png" Pack="true" PackagePath="/" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="../../../ui/**/*" Exclude="../../../ui/**/node_modules/**/*;../../../ui/**/package*.json;../../../ui/**/*.test.mjs" LogicalName="Sendproof.Ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
