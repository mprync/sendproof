<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Sendproof for Azure Cosmos DB</Title>
    <PackageTags>openapi;aspnetcore;api-testing;cosmosdb;azure</PackageTags>
    <PackageIcon>package-icon.png</PackageIcon>
    <Description>A Preview write guard for the Azure Cosmos DB .NET SDK in Sendproof: reads run, the first write blocks the Preview before it is sent.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/package-icon.png" Pack="true" PackagePath="/" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.64.0" />
    <!-- The SDK's build targets insist on a direct reference; the SDK itself serializes with it. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <ProjectReference Include="../Sendproof.AspNetCore/Sendproof.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sendproof.DataStores.Tests" />
  </ItemGroup>
</Project>
