<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Sendproof for Entity Framework Core</Title>
    <PackageTags>openapi;aspnetcore;api-testing;efcore;transactions</PackageTags>
    <PackageIcon>package-icon.png</PackageIcon>
    <Description>Transactional previews and tracked row changes for relational EF Core APIs in Sendproof.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/package-icon.png" Pack="true" PackagePath="/" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <!-- Compile-only: MySqlDataCommandGuard derives from MySql.Data's driver interceptor. It is named in a connection
         string only when the application's connection is a MySql.Data one, so applications without MySql.Data never
         load it, and the package adds no dependency. -->
    <PackageReference Include="MySql.Data" Version="26.10.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="../Sendproof.AspNetCore/Sendproof.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sendproof.EntityFrameworkCore.Tests" />
  </ItemGroup>
</Project>
