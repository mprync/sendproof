<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Test Bench for Entity Framework Core</Title>
    <PackageTags>openapi;aspnetcore;api-testing;efcore;transactions</PackageTags>
    <PackageIcon>package-icon.png</PackageIcon>
    <Description>Transactional previews and tracked row changes for relational EF Core APIs in Test Bench.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/package-icon.png" Pack="true" PackagePath="/" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <ProjectReference Include="../TestBench.AspNetCore/TestBench.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TestBench.EntityFrameworkCore.Tests" />
  </ItemGroup>
</Project>
