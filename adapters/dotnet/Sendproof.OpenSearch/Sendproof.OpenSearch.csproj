<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Sendproof for OpenSearch</Title>
    <PackageTags>openapi;aspnetcore;api-testing;opensearch</PackageTags>
    <PackageIcon>package-icon.png</PackageIcon>
    <Description>A Preview write guard for OpenSearch.Client in Sendproof: reads run, the first write blocks the Preview before it is sent.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../docs/package-icon.png" Pack="true" PackagePath="/" />
    <PackageReference Include="OpenSearch.Client" Version="2.3.0" />
    <ProjectReference Include="../Sendproof.AspNetCore/Sendproof.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sendproof.DataStores.Tests" />
  </ItemGroup>
</Project>
