<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="MongoDB.EntityFrameworkCore" Version="10.0.5" />
    <!-- Microsoft.Data.SqlClient 6.1.7 (via the SQL Server provider) pulls in 9.0.11, which has known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" PrivateAssets="all" />
    <ProjectReference Include="../../adapters/dotnet/Sendproof.EntityFrameworkCore/Sendproof.EntityFrameworkCore.csproj" />
  </ItemGroup>
</Project>
