# Consumer Gemfile for tools/release/rubygems.mjs. __VERSION__ is replaced at verify time.
# The three Sendproof gems are not on a path: they come from vendor/cache (the packed archives).
source "https://rubygems.org"

gem "rails", "~> 8.0"
gem "puma", ">= 6.4"
gem "sqlite3", ">= 2.1"
# Windows has no system zoneinfo, so ActiveSupport needs the tz database as a gem.
gem "tzinfo-data", platforms: %i[windows]
gem "sendproof-rails", "= __VERSION__"
gem "sendproof-activerecord", "= __VERSION__"
